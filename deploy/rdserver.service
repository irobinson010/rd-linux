# rdserver as a per-user systemd service.
#
# Why a *user* service: it needs your live graphical session (xdg-desktop-portal,
# PipeWire, kscreen), so it must start at graphical login -- not before. In
# --unattended mode you approve the KDE screen-share dialog ONCE; the grant is
# remembered and restarts (including over SSH) restore the capture silently.
#
# Easiest install: run ./install.sh -- it sets WorkingDirectory to your checkout and
# generates a stable, random access token for you. Manual install:
#   cp deploy/rdserver.service ~/.config/systemd/user/
#   # set WorkingDirectory below to your checkout, then:
#   systemctl --user daemon-reload && systemctl --user enable --now rdserver
#   journalctl --user -u rdserver -e        # find the connect URL/token

[Unit]
Description=Wayland WebRTC remote desktop (rdserver)
After=graphical-session.target pipewire.service
PartOf=graphical-session.target
# Portal/PipeWire may not be ready the instant we start at login; keep retrying
# (Restart=on-failure) instead of systemd giving up after a few quick failures.
StartLimitIntervalSec=0

[Service]
# notify: systemd counts the service as started only when rdserver says READY=1,
# i.e. after the portal handshake -- which on a FIRST run waits for you to approve
# the KDE share dialog, hence the long TimeoutStartSec. The watchdog then restarts
# the service if the event loop stops pinging (rdserver/sdnotify.py): a wedged
# process looks "active" to Restart=on-failure, but not to this.
Type=notify
TimeoutStartSec=10min
WatchdogSec=90
# Each WebRTC session opens ~60 descriptors (ICE candidates on every interface,
# eventfds, pipes); the user-service default soft limit of 1024 is one bad
# afternoon away, and GLib aborts the process when it can't open a pipe.
LimitNOFILE=65536
# Stay out of the way of whatever the person at the machine is doing. With the
# cgroup CPU controller active (it is, on a Plasma session) a game and this
# service sit in sibling groups of equal weight, so under contention a software
# encode here steals frame time from the game -- seen as black frames on a VRR
# panel. A low weight makes the game win; nothing here needs to be on time to
# the millisecond (Nice= covers the same for anything sharing our group).
CPUWeight=20
Nice=10
# Path to your checkout (install.sh rewrites this to the real location).
WorkingDirectory=%h/rd-linux
# Default options. NOTE: there is deliberately no token here -- install.sh writes
# a stable, randomly generated RD_TOKEN to ~/.config/rdserver/rd.env (mode 600),
# loaded via the EnvironmentFile below. Keeping the token OUT of RD_OPTS keeps it
# off the process command line (`ps`/`systemctl status` show argv to any local
# user). Without the env file the token is random each start (printed in the log).
# The '-' makes the file optional (no failure if it's absent).
Environment="RD_OPTS=--port 8098 --tls --audio --unattended"
EnvironmentFile=-%h/.config/rdserver/rd.env
ExecStart=/usr/bin/python3 -m rdserver $RD_OPTS
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
